# PiDev Agent environment — EXAMPLE ONLY.
# The real file lives on the Raspberry Pi at <PIDEV_HOME>/.env (mode 0600) and
# is written by scripts/configure.sh. Never put real values in this file and
# never commit .env.

# ---- Owned by OpenACP (read by OpenACP itself; PiDev only validates them) ----
# Bot token from @BotFather. Never paste it into Telegram.
OPENACP_TELEGRAM_BOT_TOKEN=
# Numeric ID of the PRIVATE forum supergroup (starts with -100) that contains
# only you and the bot. OpenACP ignores every other chat.
OPENACP_TELEGRAM_CHAT_ID=
# Keep public tunnels off for the MVP.
OPENACP_TUNNEL_ENABLED=false
OPENACP_LOG_LEVEL=info

# ---- Owned by PiDev ----
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Empty = nobody (PiDev fails closed, unlike OpenACP's default).
PIDEV_ALLOWED_USER_IDS=
# Absolute path on the Pi containing the projects the agent may work on.
# Default suggestion: $HOME/projects of the service account.
PIDEV_WORKSPACE_ROOT=
# Max concurrent agent sessions (applied to OpenACP security.maxConcurrentSessions).
PIDEV_MAX_CONCURRENT_TASKS=1
# A project write lock is released if its session is idle for this long.
PIDEV_LOCK_TTL_MINUTES=30
# strict = guard hook + managed Claude Code policy (only supported mode).
PIDEV_APPROVAL_MODE=strict

# ---- LLM provider (owned by PiDev; mapped onto an OpenACP coding agent) ----
#   claude -> Claude Code ("claude" agent)        PiDev guard + managed policy ACTIVE
#   openai -> Codex CLI ("codex" agent)           PiDev guard NOT active
#   gemini -> Gemini CLI ("gemini" agent)         PiDev guard NOT active
LLM_PROVIDER=claude
# Optional. Empty = the agent's default model.
#   claude: model ID or alias (e.g. claude-opus-5-5, sonnet) -> managed policy `model`
#   gemini: gemini-* model ID -> GEMINI_MODEL for the gemini agent
#   openai: NOT applied automatically; set `model` in ~/.codex/config.toml on the Pi
LLM_MODEL=
# Optional. Empty = use the agent's own login (claude auth login / codex / gemini Google sign-in).
#   claude: Anthropic Console key (sk-ant-...), served to Claude Code by bin/pidev-apikey.js
#           (apiKeyHelper) so it is never in the agent's environment.
#   openai: OpenAI key (sk-...), written to OpenACP agents.json -> OPENAI_API_KEY for codex
#   gemini: Google AI Studio key (AIza...), written to OpenACP agents.json -> GEMINI_API_KEY
# Do NOT set ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY directly: OpenACP does not
# pass them to the agent.
LLM_API_KEY=
# Must be "true" to run openai/gemini, acknowledging the PiDev guard does not cover them.
PIDEV_ALLOW_UNGUARDED_PROVIDER=false

# ---- Mac-only (used by scripts/deploy.sh and scripts/remote-inspect.sh) ----
# SSH host alias from ~/.ssh/config pointing at the Pi. Example only.
PIDEV_PI_SSH_HOST=pidev-pi
# Install path on the Pi (relative paths are relative to the remote $HOME).
PIDEV_PI_APP_DIR=pidev-agent
